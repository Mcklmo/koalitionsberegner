{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koalitionsberegner",
  // The page from Cloudflare's edge, the API forwarded to Cloud Run.
  // doc/cloudflare.md walks through the setup.
  "main": "worker/index.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    // The repo root. .assetsignore is what keeps everything but index.html and
    // js/ from becoming a public URL — .env included.
    "directory": ".",
    // So the Worker can fetch the page itself to unfurl it (worker/index.js,
    // servePage): the asset copy of index.html, headers included.
    "binding": "ASSETS",
    // Only the API, shared links and the outreach approval page run the
    // Worker. Every other static file is served without it, and so never
    // counts against the Worker's request allowance.
    "run_worker_first": ["/api/*", "/e/*", "/approve/*"]
  },
  // Three schedules (doc/plans/03-remaining-work.md, A3), dispatched in
  // worker/index.js's `scheduled` by which of these fired:
  // - 06:00 UTC daily: email whichever usage reports are due (daily always,
  //   weekly on Mondays, monthly on the 1st).
  // - every 30 minutes: refresh whichever tracked elections are due. Matches
  //   backend/app/refresh.yaml's smallest `every` — tightening the schedule
  //   there needs this tightened too, or the extra reads are never taken.
  // - 05:00 UTC on the 1st of the month: scan for new elections to track.
  "triggers": {
    "crons": ["0 6 * * *", "*/30 * * * *", "0 5 1 * *"]
  },
  "vars": {
    "ORIGIN_URL": "https://koalitionsberegner-711803377000.europe-north1.run.app"
  },
  "routes": [
    {
      "pattern": "koalitionsberegner.moritzmarcus.com",
      "custom_domain": true
    }
  ]
}
