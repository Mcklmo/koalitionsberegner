# Copy to .env and fill in what you need: `cp .env.example .env`.
#
# The backend reads this file at startup, from the repo root, and never
# overrides a variable that is already exported — so `LLM_MODE=live uv run …`
# still wins over a line here. .env is gitignored; keep it that way.
#
# Every variable is optional. With none of them set the app starts in memory,
# ungated, with a mocked extraction agent. doc/contribute.md#environment-variables
# documents them all.

# --- Storage -----------------------------------------------------------------
# firestore (needs GOOGLE_CLOUD_PROJECT) | sqlite (a file, survives restarts) | memory
ELECTION_STORE=sqlite
# SQLITE_PATH=./data/elections.db
# GOOGLE_CLOUD_PROJECT=
# FIRESTORE_DATABASE=(default)

# --- Extraction --------------------------------------------------------------
# mock (fixed result, no model call) | live (the real agent) | off (no importing)
LLM_MODE=mock
# ANTHROPIC_API_KEY=sk-ant-…

# --- Where the results are read from ----------------------------------------
# Wikipedia's article on the election is looked up and read first; it states
# seats where an electoral authority often states only votes. On by default and
# needs no key, under LLM_MODE=live. Wikimedia's API wants to know who is
# calling: it is told this project's URL unless you name yourself here.
# WIKIPEDIA_CONTACT=you@example.com
# WIKIPEDIA=on
# WIKIPEDIA_LANGUAGE=en

# IFES ElectionGuide is a third calendar source (plan 3, A5) the monthly scan
# may read for coming elections. Off by default and stays off until the owner
# has IFES's written confirmation that this project's non-profit, sponsor-
# funded use counts as non-commercial under their data use policy — see
# doc/contribute.md and app/calendar.py's module docstring. Do not set this to
# "on" without that confirmation.
# IFES_ELECTIONGUIDE=off

# --- The owner's secret ------------------------------------------------------
# Importing spends money and is the owner's alone: the page sends this as
# x-admin-secret once it is pasted in at /#admin. Unset, a local run is open to
# whoever uses it; Cloud Run refuses to start without it. At least 32 characters.
# ADMIN_SECRET=   # openssl rand -hex 32

# Where this site is reachable, as an absolute URL. A plain variable, not a
# secret. Nothing needs it today except the approval email in
# doc/plans/04-reddit-outreach.md.
# PUBLIC_BASE_URL=http://localhost:8000

# --- Election requests --------------------------------------------------------
# Anyone can ask for an election that has not been imported: it is filed as an
# issue on this repository and imported by hand. Both together, or neither —
# with no token the page is told not to offer it.
#
# The token is a fine-grained PAT with "Issues: write" on that repository ONLY.
# Deliberately not called GITHUB_TOKEN: that name is set by GitHub Actions and
# by several agent runtimes, and a token that happens to be in the environment
# is not a decision to open issues with it.
# GITHUB_ISSUES_TOKEN=github_pat_…
# GITHUB_ISSUES_REPO=mcklmo/koalitionsberegner

# --- Usage reports -----------------------------------------------------------
# What people do with the app is counted per day, as numbers only, in the same
# store as everything else. With these four set, a daily report is emailed
# (weekly on Mondays, monthly on the 1st) whenever the Cloudflare Worker's cron
# calls /api/internal/usage-reports with USAGE_REPORT_SECRET. All four, or none:
# without them an administrator can still read a report at /api/admin/usage.
# Gmail: SMTP_HOST=smtp.gmail.com and an app password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app-password
# REPORT_EMAIL_TO=you@example.com
# REPORT_EMAIL_FROM=you@gmail.com
# USAGE_REPORT_SECRET=   # openssl rand -hex 32; the Worker needs the same value

# --- Outreach: the Reddit approval gate --------------------------------------
# The `outreach` plugin (plugins/outreach/) queues drafts on this deployment;
# see doc/plans/04-reddit-outreach.md. With none of the five REDDIT_* variables
# set, the queue, the email and the approval page all work — only the send
# route answers 503, because there is nowhere to post to yet.
#
# A script-app OAuth login (github.com/reddit-archive/reddit/wiki/OAuth2):
# create the app at reddit.com/prefs/apps as "script", then use its id and
# secret with the same account's username and password. All five or none.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_USER_AGENT=koalitionsberegner-outreach/1.0 (by /u/you; contact you@example.com)

# This deployment's own allowlist of subreddits it may post to — not the same
# variable as the scanner's OUTREACH_SUBREDDITS, so a subreddit the scanner no
# longer reads from is not silently still postable.
# OUTREACH_ALLOWED_SUBREDDITS=denmark
# OUTREACH_SUBREDDIT_WEEKLY_CAP=2
# OUTREACH_DAILY_CAP=3
#
# With ELECTION_STORE=firestore, the weekly and daily caps above need two
# composite indexes deployed first (firestore.indexes.json; the gcloud
# commands are in doc/contribute.md's "Cloud setup" section) -- without them
# the first send 500s instead of enforcing a cap.

# --- Donate and sponsor (plan 3, C4) ------------------------------------------
# One link in the footer, the owner's choice of GitHub Sponsors, Ko-fi or
# MobilePay. Unset hides it. SUPPORT_SPONSOR is a separate, optional "Supported
# by ..." line under the calculator -- plain text, shown as text.
# SUPPORT_LINK=https://github.com/sponsors/mcklmo
# SUPPORT_SPONSOR=

# --- Misc --------------------------------------------------------------------
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://example.com
